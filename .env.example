NODE_ENV=development
PORT=5000

# Backend CORS: comma-separated allowed frontend origins
FRONTEND_ORIGIN=http://localhost:5173
# Frontend build-time API URL (empty = same-origin / vite proxy in dev)
VITE_API_BASE_URL=http://localhost:5000

# Leave empty to use OS temp dir + /clip2gif
TEMP_DIR=
MAX_UPLOAD_MB=100
MAX_SOURCE_DURATION_SECONDS=600
MAX_CLIP_DURATION_SECONDS=120
MAX_GIF_OUTPUT_MB=50

MAX_ACTIVE_CONVERSIONS=1
MAX_QUEUED_JOBS=3

TEMP_FILE_TTL_MINUTES=30
JOB_TIMEOUT_SECONDS=900
CLEANUP_INTERVAL_MINUTES=5
