# Clip2GIF frontend — environment template.
# Copy to `.env.development.local` (same folder) for local dev. Local files are
# git-ignored; this template is tracked.
# Production: set VITE_API_BASE_URL in the Render Dashboard (Static Site >
# Environment) to the public HTTPS URL of the deployed backend, then rebuild.
# NOTE: VITE_* values are embedded in the client bundle at build time.
# Never put secrets here.

# Local backend:
VITE_API_BASE_URL=http://localhost:5000

# Production example (DO NOT commit a real URL here — set it in Render):
# VITE_API_BASE_URL=https://YOUR-BACKEND-SERVICE.onrender.com
