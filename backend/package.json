{
  "name": "clip2gif-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Clip2GIF backend — video to GIF conversion API",
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "prestart": "node -e \"if(!require('fs').existsSync('dist/server.js')){console.error('[clip2gif] dist/server.js not found - the production build never ran. Locally run: npm run build. On Render set Root Directory=backend and Build Command=npm install --include=dev && npm run build.');process.exit(1)}\"",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration.test.ts",
    "test:long": "LONG_TESTS=1 vitest run tests/long.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.12",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.8",
    "supertest": "^7.0.0",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=18"
  }
}
