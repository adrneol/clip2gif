# Clip2GIF backend — local development template.
# Copy to `.env` (same folder) and adjust. `.env` is git-ignored; this file is tracked.
# Production values are set in the Render Dashboard, NOT here.

NODE_ENV=development
PORT=5000

# Comma-separated allowed frontend origins for CORS
FRONTEND_ORIGIN=http://localhost:5173

# Leave empty to use the OS temporary directory + /clip2gif
TEMP_DIR=

MAX_UPLOAD_MB=100
MAX_SOURCE_DURATION_SECONDS=600
MAX_CLIP_DURATION_SECONDS=120
MAX_GIF_OUTPUT_MB=50

MAX_ACTIVE_CONVERSIONS=1
MAX_QUEUED_JOBS=3

TEMP_FILE_TTL_MINUTES=30
JOB_TIMEOUT_SECONDS=900
CLEANUP_INTERVAL_MINUTES=5

# Default quality preset (tiny|compact|balanced|high|max)
DEFAULT_PRESET=balanced
